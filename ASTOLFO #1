        resizeBatch[#resizeBatch+1] = {Part = p, Size = PIXEL_SIZE, CFrame = partCF}
        colorBatch[#colorBatch+1]  = {Part = p, Color = Color3.new(d[3], d[4], d[5]), UnionColoring = false}
    end
end

if #resizeBatch > 0 then endpoint:InvokeServer("SyncResize",  resizeBatch) end
if #colorBatch  > 0 then endpoint:InvokeServer("SyncColor",   colorBatch)  end

