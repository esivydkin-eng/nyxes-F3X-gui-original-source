	raycastParams.FilterType = Enum.RaycastFilterType.Exclude
	
	local function updateRaycastFilter()
		local ignoreList = {}
		for _, plr in ipairs(game.Players:GetPlayers()) do
			if plr.Character then table.insert(ignoreList, plr.Character) end
		end
		raycastParams.FilterDescendantsInstances = ignoreList
	end
	
	local function spawnParticle(head)
		if not head or not head.Parent then return end
	
		local startPos = head.Position + Vector3.new(math.random(-2, 2), 1.5, math.random(-2, 2))
		local ceilingY = head.Position.Y + HEIGHT_LIMIT
	
		local angle = math.rad(math.random(0, 360))
		local speed = math.random(8, 20) 
		local vx = math.cos(angle) * speed
		local vz = math.sin(angle) * speed
		local vy = RISE_SPEED
	
		local p = remote:InvokeServer("CreatePart", "Normal", CFrame.new(startPos), workspace)
		if not p then return end
	
		table.insert(spawnedParticles, p)
	
		local success = pcall(function()
