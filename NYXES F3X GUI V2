			table.insert(toDelete, p)
			return
		end
	
		task.spawn(function()
			local elapsed = 0
			local dt = 0.03
			local currentPos = startPos
			local isDead = false
	
			local lifeLimit = MAX_LIFE * DELETE_STAGE
	
			while elapsed < lifeLimit and alive[1] and not isDead do
				if not p or not p.Parent then break end
	
				local direction = Vector3.new(vx * dt, vy * dt, vz * dt)
				local nextPos = currentPos + direction
	
				if nextPos.Y >= ceilingY then 
					isDead = true
					break 
				end
	
				local rayResult = workspace:Raycast(currentPos, direction, raycastParams)
				if rayResult and rayResult.Instance and rayResult.Instance.Name ~= "Particle" then
					isDead = true
					break
				end
	
				currentPos = nextPos
	
				local moveSuccess = pcall(function()
					remote:InvokeServer("SyncResize", {{Part=p, CFrame=CFrame.new(currentPos), Size=PART_SIZE}})
				end)
	
				if not moveSuccess then
					isDead = true
					break
				end
	
				elapsed = elapsed + dt
				task.wait(dt)
			end
	
			table.insert(toDelete, p)
			local idx = table.find(spawnedParticles, p)
			if idx then table.remove(spawnedParticles, idx) end
		end)
	end
	
	task.spawn(function()
		while alive[1] do
			updateRaycastFilter()
			local heads = getHeads()
			if #heads > 0 then
				for _, head in ipairs(heads) do
					for i = 1, 4 do
