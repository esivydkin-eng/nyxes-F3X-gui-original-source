	local BOOT = script.Parent
	local ReplicatedStorage = game:GetService("ReplicatedStorage")
	local RequestCommand = ReplicatedStorage:WaitForChild("HDAdminHDClient").Signals.RequestCommandModification
	
	local function run(cmd)
		RequestCommand:InvokeServer(cmd)
		task.wait(2.2)
	end
	
	local function isSoundValid(id)
		local targetSound = nil
	
		for _, s in pairs(workspace:GetDescendants()) do
			if s:IsA("Sound") and s.SoundId:find(tostring(id)) then
				targetSound = s
				break
			end
		end
	
		if not targetSound then return false end
		local pos1 = targetSound.TimePosition
		task.wait(0.5) 
		local pos2 = targetSound.TimePosition
		return pos2 > pos1
	end
	
	BOOT.MouseButton1Click:Connect(function()
		local id1 = "99911892592945"
		local id2 = "118233189648071"
	
		run(";music " .. id1 .. " , ;pitch 0.0725 , ;volume 10")
	
		if isSoundValid(id1) then
			return 
		end
	
		run(";sh sound id not valid")
		run(";music " .. id2 .. " , ;pitch 0.0925 , ;volume 10")
	
		if not isSoundValid(id2) then
			run(";sh 2 sound not valided")
		end
	end)
end;
