local P = {}
local pending = 0

print("[F3X Art]: Спавним 12672 пикселей...")

for id, d in ipairs(pixelData) do
    pending = pending + 1
    task.spawn(function()
        local partCF = originCF * CFrame.new(d[1], d[2], 0)
        local ok, part = pcall(function()
            return endpoint:InvokeServer("CreatePart", "Normal", partCF, workspace)
        end)
        if ok and part and part.Parent then
            P[id] = part
            endpoint:InvokeServer("SyncAnchor", {{Part = part, Anchored = true}})
        end
        pending = pending - 1
    end)
end

while pending > 0 do task.wait() end

print("[F3X Art]: Части созданы: " .. #P .. "/" .. #pixelData .. " | Применяю размер и цвет...")

-- Один InvokeServer на resize, один на color
local resizeBatch = {}
local colorBatch  = {}

for id, d in ipairs(pixelData) do
    local p = P[id]
    if p and p.Parent then
        local partCF = originCF * CFrame.new(d[1], d[2], 0)
        resizeBatch[#resizeBatch+1] = {Part = p, Size = PIXEL_SIZE, CFrame = partCF}
        colorBatch[#colorBatch+1]  = {Part = p, Color = Color3.new(d[3], d[4], d[5]), UnionColoring = false}
    end
end

if #resizeBatch > 0 then endpoint:InvokeServer("SyncResize",  resizeBatch) end
if #colorBatch  > 0 then endpoint:InvokeServer("SyncColor",   colorBatch)  end

-- Финальный проход якорей (на случай если что отвязалось)
task.wait(0.3)
local missed = {}
for id, p in pairs(P) do
    if p and p.Parent and not p.Anchored then
        missed[#missed+1] = {Part = p, Anchored = true}
    end
end
if #missed > 0 then
    for i = 1, #missed, 100 do
        local chunk = {}
        for j = i, math.min(i+99, #missed) do chunk[#chunk+1] = missed[j] end
        endpoint:InvokeServer("SyncAnchor", chunk)
        task.wait()
    end
end

print("[F3X Art]: Completed! " .. #P .. " Pixels // made by nyxes | discord link: https://discord.gg/f8XP9kKYpS")
